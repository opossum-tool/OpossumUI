{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeTypes",
    ":automergeLinters",
    ":automergeTesters",
    ":automergeMinor",
    ":automergeBranch",
    "monorepo:yarn"
  ],
  "addLabels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prCreation": "not-pending",
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["yarnDedupeHighest"],
  "packageRules": [
    {
      "description": "The .nvmrc node version is driven by Electron - synced via sync-node-version workflow",
      "matchManagers": ["nvm"],
      "enabled": false
    },
    {
      "description": "The package.json engines node version is driven by Electron - synced via sync-node-version workflow",
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "description": "The @types/node version is driven by Electron - synced via sync-node-version workflow",
      "matchPackageNames": ["@types/node"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"]
}
